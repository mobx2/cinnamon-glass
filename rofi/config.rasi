configuration {
    modi: "drun,run,window,filebrowser";
    show-icons: true;
    icon-theme: "kora";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    display-filebrowser: "Files";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    click-to-exit: true;
    kb-cancel: "Escape,Control+g,Control+bracketleft";
    disable-history: false;
    monitor: "primary";
}

@theme "spotlight"
